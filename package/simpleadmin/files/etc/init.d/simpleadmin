#!/bin/sh /etc/rc.common
START=99
USE_PROCD=1
start_service() {
    iptables -C INPUT -p tcp --dport 8088 -j ACCEPT 2>/dev/null || iptables -I INPUT -p tcp --dport 8088 -j ACCEPT
    procd_open_instance
    procd_set_param command /usr/bin/simpleadmin-httpd serve \
        --http :8088 --https :8443 --no-tls=false --no-auth=true \
        --static /etc/simpleadmin/www \
        --auth-file /etc/simpleadmin/simpleadmin.auth
    procd_set_param respawn 3600 5 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
    ( /usr/bin/simpleadmin-menu-sync.sh >/dev/null 2>&1 ) &
}
